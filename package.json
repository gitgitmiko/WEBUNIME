{
  "name": "webunime",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/app.js",
    "import:catalog": "node server/import-catalog.js",
    "push:catalog-api": "node scripts/push-catalog-to-api.js",
